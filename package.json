{
  "name": "discord-bot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "sh scripts/prepare.sh",
    "dev": "npm run dev:api & npm run dev:bot",
    "dev:bot": "npm run dev --workspace=@discord-bot/bot",
    "dev:api": "npm run dev --workspace=@discord-bot/api",
    "dev:doc": "npm run dev --workspace=@discord-bot/doc",
    "build": "npm run build -w @discord-bot/shared && npm run build -w @discord-bot/discord-client && npm run build -w @discord-bot/api && npm run build -w @discord-bot/bot",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version:packages": "changeset version && node scripts/release/stamp-doc-version.js",
    "prisma:init": "npm run prisma:init --workspace=@discord-bot/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@discord-bot/api",
    "prisma:deploy": "npm run prisma:deploy --workspace=@discord-bot/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:release": "node scripts/release/build.js",
    "test": "node --test 'apps/*/test/**/*.test.ts' 'packages/*/test/**/*.test.ts' 'scripts/test/*.test.js'",
    "test:release": "node --test scripts/test/package.e2e.js"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "esbuild": "^0.21.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "type": "module"
}
