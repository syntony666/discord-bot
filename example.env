# Discord
DISCORD_TOKEN=
DISCORD_APP_ID=

# Database (apps/api owns prisma; apps/bot only needs this until Step 4)
DATABASE_URL=postgresql://user:password@localhost:5432/discord_bot

# API (Step 3+: apps/api listens on API_PORT, apps/bot calls API_URL)
API_PORT=3001
API_URL=http://localhost:3001

# Bot health endpoint
HEALTH_PORT=3000

# Twitch (optional, stream-notify)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Timezone for the process (optional; scheduled daily tasks take explicit timeZone)
TZ=Asia/Taipei

# NODE_ENV=development
