{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@core/*": [
        "core/*"
      ],
      "@features/*": [
        "features/*"
      ],
      "@platforms/*": [
        "platforms/*"
      ],
      "@commands/*": [
        "commands/*"
      ],
      "@shared/*": [
        "shared/*"
      ],
      "@prisma-client/*": [
        ".prisma/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
